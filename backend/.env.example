# ---------- Gnani speech APIs (Prisma STT + Timbre TTS) ----------
# Get a key at https://app.gnani.ai after registering for the challenge.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
PRISMA_MODEL=prisma-v3.0
# Timbre v3.0 voices speak all 10 languages. "Chetana" is Gnani's
# warm healthcare voice. For timbre-v2.5 use Trisha (ta-IN) / Chitra (hi-IN).
TIMBRE_MODEL=timbre-v3.0
TIMBRE_VOICE_TA=Chetana
TIMBRE_VOICE_HI=Chetana

# ---------- Evon v3.3 (LLM) ----------
# Evon is open-weight (huggingface.co/gnani/gnani-evon-v3.3-30B-A3B).
# Serve it with vLLM or llama.cpp, both expose an OpenAI-compatible API.
# See docs/EVON_HOSTING.md
EVON_BASE_URL=http://localhost:8001/v1
EVON_API_KEY=not-needed
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# ---------- Modes ----------
# MOCK_STT=1  -> no Gnani STT calls; reads a sidecar .txt transcript or a fixed demo line
# MOCK_TTS=1  -> no Gnani TTS calls; returns a short silent wav
# MOCK_LLM=1  -> no Evon calls; uses the built-in regex extractor
# Start with all three = 1 to build the UI without spending credits.
MOCK_STT=1
MOCK_TTS=1
MOCK_LLM=1

DB_PATH=data/asha_vaani.db
CACHE_DIR=data/cache
# Pretend "today" for demos (YYYY-MM-DD). Leave empty for the real date.
DEMO_TODAY=
